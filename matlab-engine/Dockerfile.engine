FROM vault-matlab-compiler:r2025b
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* && python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
WORKDIR /app
COPY matlab-engine/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt /opt/matlab/R2025b/extern/engines/python
COPY vault_core vault_core
COPY matlab-engine/service.py service.py
COPY matlab-engine/matlab_host.py matlab_host.py
COPY matlab-engine/src src
ENV SCORING_BACKEND=matlab-engine
EXPOSE 9910
USER matlab
ENTRYPOINT []
CMD ["uvicorn", "service:app", "--host", "0.0.0.0", "--port", "9910", "--no-access-log"]
