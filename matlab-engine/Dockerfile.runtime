FROM containers.mathworks.com/matlab-runtime:r2025b
USER root
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* && python3 -m venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
ENV AGREE_TO_MATLAB_RUNTIME_LICENSE=yes
ENV LD_LIBRARY_PATH=/opt/matlabruntime/R2025b/runtime/glnxa64:/opt/matlabruntime/R2025b/bin/glnxa64:/opt/matlabruntime/R2025b/sys/os/glnxa64:/opt/matlabruntime/R2025b/sys/opengl/lib/glnxa64:/opt/matlabruntime/R2025b/extern/bin/glnxa64
WORKDIR /app
COPY matlab-engine/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY matlab-engine/build/vault_matlab /tmp/vault_matlab
RUN test -f /tmp/vault_matlab/setup.py && pip install /tmp/vault_matlab
COPY vault_core vault_core
COPY matlab-engine/service.py service.py
ENV SCORING_BACKEND=matlab-runtime
EXPOSE 9910
ENTRYPOINT []
CMD ["uvicorn", "service:app", "--host", "0.0.0.0", "--port", "9910", "--no-access-log"]
